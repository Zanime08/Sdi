<Page x:Class="Sdi.ShopPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Магазин"
      Background="{DynamicResource Bg}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Магазин персонажей"
                   FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="10"/>

        <ScrollViewer Grid.Row="1">
            <StackPanel>

                <Border BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        Background="{DynamicResource Card}" Margin="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Селестия" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Целитель, ур. 35"/>
                        <TextBlock Text="Цена: 1200" Foreground="{DynamicResource Gold}" FontWeight="Bold"/>
                        <TextBlock Text="Купить"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        Background="{DynamicResource Card}" Margin="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Кратос" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Танк, ур. 50"/>
                        <TextBlock Text="Цена: 2400" Foreground="{DynamicResource Gold}" FontWeight="Bold"/>
                        <TextBlock Text="Купить"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        Background="{DynamicResource Card}" Margin="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Игнис" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Огнестрел, ур. 33"/>
                        <TextBlock Text="Цена: 980" Foreground="{DynamicResource Gold}" FontWeight="Bold"/>
                        <TextBlock Text="Купить"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
