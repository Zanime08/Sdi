<Page x:Class="Sdi.ShopPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Sdi"
      mc:Ignorable="d"
      d:DesignHeight="1080" d:DesignWidth="1640"
      Background="{DynamicResource BrushBgApp}"
      Title="Магазин персонажей">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="16"/>
            <Setter Property="Width" Value="480"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style x:Key="CharName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="CharClass" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="PriceText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushGold}"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- Кнопка «Купить» -->
        <Style x:Key="BuyButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushBgApp}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushGood}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <!-- Контент разбит на фреймы (сетка) -->
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Фрейм-заголовок -->
        <StackPanel Grid.Row="0" Margin="8,8,8,18">
            <TextBlock Text="Магазин персонажей" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Персонажи, доступные для покупки" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- Фрейм с карточками для покупки -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <!-- На продажу 1 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Width="100" Height="100" HorizontalAlignment="Center">
                            <Ellipse Fill="{DynamicResource BrushAccent2}"/>
                            <TextBlock Text="С" Foreground="White" FontSize="46" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Селестия" Style="{StaticResource CharName}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="Целитель · ур. 35" Style="{StaticResource CharClass}" HorizontalAlignment="Center"/>
                        <TextBlock Text="1 200 ◊" Style="{StaticResource PriceText}"/>
                        <Button Style="{StaticResource BuyButton}" Content="Купить"/>
                    </StackPanel>
                </Border>

                <!-- На продажу 2 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Width="100" Height="100" HorizontalAlignment="Center">
                            <Ellipse Fill="{DynamicResource BrushDanger}"/>
                            <TextBlock Text="К" Foreground="White" FontSize="46" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Кратос" Style="{StaticResource CharName}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="Танк · ур. 50" Style="{StaticResource CharClass}" HorizontalAlignment="Center"/>
                        <TextBlock Text="2 400 ◊" Style="{StaticResource PriceText}"/>
                        <Button Style="{StaticResource BuyButton}" Content="Купить"/>
                    </StackPanel>
                </Border>

                <!-- На продажу 3 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Width="100" Height="100" HorizontalAlignment="Center">
                            <Ellipse Fill="{DynamicResource BrushGood}"/>
                            <TextBlock Text="И" Foreground="{DynamicResource BrushBgApp}" FontSize="46" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Игнис" Style="{StaticResource CharName}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="Огнестрел · ур. 33" Style="{StaticResource CharClass}" HorizontalAlignment="Center"/>
                        <TextBlock Text="980 ◊" Style="{StaticResource PriceText}"/>
                        <Button Style="{StaticResource BuyButton}" Content="Купить"/>
                    </StackPanel>
                </Border>

                <!-- На продажу 4 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Width="100" Height="100" HorizontalAlignment="Center">
                            <Ellipse Fill="{DynamicResource BrushGold}"/>
                            <TextBlock Text="Н" Foreground="{DynamicResource BrushBgApp}" FontSize="46" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Ноктюрн" Style="{StaticResource CharName}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="Некромант · ур. 47" Style="{StaticResource CharClass}" HorizontalAlignment="Center"/>
                        <TextBlock Text="3 150 ◊" Style="{StaticResource PriceText}"/>
                        <Button Style="{StaticResource BuyButton}" Content="Купить"/>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </ScrollViewer>
    </Grid>
</Page>
