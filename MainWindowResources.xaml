<!--
    Стили интерфейса главного окна (SDI – редактор персонажей).
    Вынесены в отдельный файл и подключаются в MainWindow.xaml.
    Цвета берутся из словаря Palette.xaml через DynamicResource,
    чтобы палитра оставалась в одном месте.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Обычная кнопка-команда в левой панели -->
    <Style x:Key="ElMenu" TargetType="StackPanel">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BrushPanelHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Кнопка-логотип (картинка без стандартной рамки) -->
    <Style x:Key="ButtonMenu" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="22"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Выделенная (активная) команда -->
    <Style x:Key="SelectedButtonMenu"
           BasedOn="{StaticResource ElMenu}"
           TargetType="StackPanel">
        <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
    </Style>
</ResourceDictionary>
