<!-- Стили командной панели (отдельный файл) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ElMenu" TargetType="StackPanel">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style x:Key="ButtonMenu" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="18"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SelectedButtonMenu" BasedOn="{StaticResource ElMenu}" TargetType="StackPanel">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
    </Style>
</ResourceDictionary>
