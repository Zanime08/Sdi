<!-- Общие стили. ResourceDictionary — словарь с оформлением элементов.
     x:Key — имя стиля, TargetType — для какого элемента он предназначен.
     Setter задаёт одно свойство (Property) и его значение (Value).
     StaticResource берёт кисть по имени из Palette.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Обычная кнопка с картинкой, без собственного шаблона.
         Margin — внешний отступ, Padding — отступ внутри кнопки.
         Cursor="Hand" меняет указатель мыши на руку. -->
    <Style x:Key="ButtonMenu" TargetType="Button">
        <Setter Property="Margin" Value="18"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Подпись команды: светлый текст по центру панели. -->
    <Style x:Key="MenuLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Bg}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Заголовок страницы: размер шрифта, жирное начертание, цвет и отступ. -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Panel}"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <!-- Карточка: рамка толщиной 1 пиксель, фон и отступы. -->
    <Style x:Key="CharacterCard" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Card}"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- Имя персонажа: крупный жирный текст зелёного цвета. -->
    <Style x:Key="CharacterNameStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource CharacterName}"/>
    </Style>

    <!-- Цена выделяется жирным шрифтом и тёмно-оранжевым цветом. -->
    <Style x:Key="PriceStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Price}"/>
    </Style>

    <!-- Цвет статической надписи «Купить». Это не работающая кнопка покупки. -->
    <Style x:Key="BuyLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Price}"/>
    </Style>
</ResourceDictionary>
