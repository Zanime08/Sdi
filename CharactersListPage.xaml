<Page x:Class="Sdi.CharactersListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Персонажи"
      Background="{DynamicResource Bg}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Список персонажей"
                   FontSize="32" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="10"/>

        <ScrollViewer Grid.Row="1">
            <StackPanel>

                <Border BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        Background="{DynamicResource Card}" Margin="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Айронхарт" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Страж, ур. 42"/>
                        <TextBlock Text="Здоровье: 3200   Атака: 540   Защита: 780"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        Background="{DynamicResource Card}" Margin="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Лунара" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Маг, ур. 38"/>
                        <TextBlock Text="Здоровье: 2100   Атака: 910   Защита: 320"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        Background="{DynamicResource Card}" Margin="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Тенебра" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Убийца, ур. 45"/>
                        <TextBlock Text="Здоровье: 1850   Атака: 1120   Защита: 260"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
