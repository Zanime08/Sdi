    <!-- Словари ресурсов (стили и палитра) -->
    <ResourceDictionary Include="MainWindowResources.xaml" />
    <ResourceDictionary Include="Palette.xaml" />
  </ItemGroup>

  <!-- ===== Картинки-логотипы команд ===== -->
  <ItemGroup>
    <Resource Include="Assets\Image\characters.png" />
    <Resource Include="Assets\Image\shop.png" />
    <Resource Include="Assets\Image\settings.png" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\Framework\v4.0\Microsoft.Wpf.targets" />
</Project>
