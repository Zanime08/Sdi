<Window x:Class="Sdi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sdi"
        mc:Ignorable="d"
        Title="SDI · Редактор персонажей"
        Height="1080" Width="1920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBgApp}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MainWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- Левая вертикальная полоска команд и рабочая область -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== ЛЕВАЯ ПАНЕЛЬ КОМАНД ===== -->
        <Grid Grid.Column="0" Background="{DynamicResource BrushPanel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок приложения -->
            <StackPanel Grid.Row="0" Margin="20,24,20,12">
                <TextBlock Text="РЕДАКТОР"
                           Foreground="{DynamicResource BrushAccent}"
                           FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="ПЕРСОНАЖЕЙ"
                           Foreground="{DynamicResource BrushText}"
                           FontSize="26" FontWeight="Bold"/>
            </StackPanel>

            <!-- 1.1 Список всех персонажей -->
            <StackPanel Grid.Row="1"
                        x:Name="StackCharacters"
                        Style="{StaticResource SelectedButtonMenu}">
                <Button x:Name="BtnCharacters"
                        Tag="CharactersListPage.xaml"
                        Style="{StaticResource ButtonMenu}"
                        Click="SwithSelect">
                    <Image Source="/Assets/Image/characters.png"/>
                </Button>
                <TextBlock Text="Персонажи"
                           HorizontalAlignment="Center"
                           Margin="0,-6,0,0"
                           Foreground="{DynamicResource BrushText}"
                           FontSize="14"/>
            </StackPanel>

            <!-- 1.2 Покупка персонажей -->
            <StackPanel Grid.Row="2"
                        x:Name="StackShop"
                        Style="{StaticResource ElMenu}">
                <Button x:Name="BtnShop"
                        Tag="ShopPage.xaml"
                        Style="{StaticResource ButtonMenu}"
                        Click="SwithSelect">
                    <Image Source="/Assets/Image/shop.png"/>
                </Button>
                <TextBlock Text="Магазин"
                           HorizontalAlignment="Center"
                           Margin="0,-6,0,0"
                           Foreground="{DynamicResource BrushText}"
                           FontSize="14"/>
            </StackPanel>

            <!-- Настройки (дополнительно) -->
            <StackPanel Grid.Row="3"
                        x:Name="StackSettings"
                        Style="{StaticResource ElMenu}">
                <Button x:Name="BtnSettings"
                        Tag="SettingsPage.xaml"
                        Style="{StaticResource ButtonMenu}"
                        Click="SwithSelect">
                    <Image Source="/Assets/Image/settings.png"/>
                </Button>
                <TextBlock Text="Настройки"
                           HorizontalAlignment="Center"
                           Margin="0,-6,0,0"
                           Foreground="{DynamicResource BrushText}"
                           FontSize="14"/>
            </StackPanel>
        </Grid>

        <!-- ===== РАБОЧАЯ ОБЛАСТЬ (фрейм со страницами) ===== -->
        <Frame x:Name="FrameArea"
               Grid.Column="1"
               Background="{DynamicResource BrushBgApp}"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
