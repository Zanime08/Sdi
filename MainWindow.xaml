<Window x:Class="Sdi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор персонажей" Height="1080" Width="1920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MainWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая вертикальная полоска команд -->
        <Grid Grid.Column="0" Background="{DynamicResource Panel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" x:Name="StackCharacters" Style="{StaticResource SelectedButtonMenu}">
                <Button x:Name="BtnCharacters" Tag="CharactersListPage.xaml"
                        Style="{StaticResource ButtonMenu}" Click="SwithSelect">
                    <Image Source="/Assets/Image/characters.png"/>
                </Button>
                <TextBlock Text="Персонажи" HorizontalAlignment="Center" Foreground="White"/>
            </StackPanel>

            <StackPanel Grid.Row="1" x:Name="StackShop" Style="{StaticResource ElMenu}">
                <Button x:Name="BtnShop" Tag="ShopPage.xaml"
                        Style="{StaticResource ButtonMenu}" Click="SwithSelect">
                    <Image Source="/Assets/Image/shop.png"/>
                </Button>
                <TextBlock Text="Магазин" HorizontalAlignment="Center" Foreground="White"/>
            </StackPanel>
        </Grid>

        <!-- Рабочая область -->
        <Frame x:Name="FrameArea" Grid.Column="1" Background="{DynamicResource Bg}"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
