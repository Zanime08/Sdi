<!-- Все 20 цветов из задания.
     SolidColorBrush — одноцветная кисть для фона, текста или рамки.
     x:Key — имя кисти. Color — цвет в формате #RRGGBB.
     Например, {StaticResource Bg} берёт кисть с именем Bg из этого файла. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Основной цвет: пять жёлтых оттенков. -->
    <SolidColorBrush x:Key="Yellow" Color="#FFE800"/>
    <!-- Border — цвет рамок карточек и кнопок. -->
    <SolidColorBrush x:Key="Border" Color="#BFB230"/>
    <SolidColorBrush x:Key="YellowDark" Color="#A69700"/>
    <!-- Card — фон карточек персонажей. -->
    <SolidColorBrush x:Key="Card" Color="#FFEE40"/>
    <!-- Bg — общий фон окна и страниц. -->
    <SolidColorBrush x:Key="Bg" Color="#FFF273"/>

    <!-- Вторичный цвет A: пять зелёных оттенков. -->
    <SolidColorBrush x:Key="Green" Color="#00AF64"/>
    <SolidColorBrush x:Key="GreenMuted" Color="#218359"/>
    <!-- CharacterName — цвет имени персонажа. -->
    <SolidColorBrush x:Key="CharacterName" Color="#007241"/>
    <SolidColorBrush x:Key="GreenLight" Color="#36D792"/>
    <SolidColorBrush x:Key="GreenPale" Color="#61D7A4"/>

    <!-- Вторичный цвет B: пять оранжевых оттенков. -->
    <SolidColorBrush x:Key="Orange" Color="#FF4900"/>
    <SolidColorBrush x:Key="OrangeMuted" Color="#BF5930"/>
    <!-- Price — цвет цены и надписи «Купить». -->
    <SolidColorBrush x:Key="Price" Color="#A62F00"/>
    <SolidColorBrush x:Key="OrangeLight" Color="#FF7640"/>
    <SolidColorBrush x:Key="OrangePale" Color="#FF9B73"/>

    <!-- Дополнительный цвет: пять фиолетовых оттенков. -->
    <!-- Accent — фон кнопок меню. -->
    <SolidColorBrush x:Key="Accent" Color="#530FAD"/>
    <SolidColorBrush x:Key="PurpleMuted" Color="#4F2982"/>
    <!-- Panel — фон меню; этой же кистью рисуем обычный текст на светлом фоне. -->
    <SolidColorBrush x:Key="Panel" Color="#330570"/>
    <SolidColorBrush x:Key="PurpleLight" Color="#8243D6"/>
    <SolidColorBrush x:Key="PurplePale" Color="#996AD6"/>
</ResourceDictionary>
