<!-- Цветовая палитра (простая) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Bg"     Color="#ECECEC"/>
    <SolidColorBrush x:Key="Panel"  Color="#4A4A4A"/>
    <SolidColorBrush x:Key="Accent" Color="#3B7DD8"/>
    <SolidColorBrush x:Key="Text"   Color="#222222"/>
    <SolidColorBrush x:Key="Card"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Border" Color="#BBBBBB"/>
    <SolidColorBrush x:Key="Gold"   Color="#C9991A"/>
</ResourceDictionary>
