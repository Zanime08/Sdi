<!-- Палитра из задания: основной цвет и три дополнительные группы. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Основной цвет -->
    <Color x:Key="Primary">#FFE800</Color>
    <Color x:Key="PrimaryMuted">#BFB230</Color>
    <Color x:Key="PrimaryDark">#A69700</Color>
    <Color x:Key="PrimaryLight">#FFEE40</Color>
    <Color x:Key="PrimaryPale">#FFF273</Color>

    <!-- Вторичный цвет A -->
    <Color x:Key="SecondaryA">#00AF64</Color>
    <Color x:Key="SecondaryAMuted">#218359</Color>
    <Color x:Key="SecondaryADark">#007241</Color>
    <Color x:Key="SecondaryALight">#36D792</Color>
    <Color x:Key="SecondaryAPale">#61D7A4</Color>

    <!-- Вторичный цвет B -->
    <Color x:Key="SecondaryB">#FF4900</Color>
    <Color x:Key="SecondaryBMuted">#BF5930</Color>
    <Color x:Key="SecondaryBDark">#A62F00</Color>
    <Color x:Key="SecondaryBLight">#FF7640</Color>
    <Color x:Key="SecondaryBPale">#FF9B73</Color>

    <!-- Дополнительный цвет -->
    <Color x:Key="Complementary">#530FAD</Color>
    <Color x:Key="ComplementaryMuted">#4F2982</Color>
    <Color x:Key="ComplementaryDark">#330570</Color>
    <Color x:Key="ComplementaryLight">#8243D6</Color>
    <Color x:Key="ComplementaryPale">#996AD6</Color>

    <!-- Кисти для элементов интерфейса -->
    <SolidColorBrush x:Key="Bg" Color="{StaticResource PrimaryPale}"/>
    <SolidColorBrush x:Key="Panel" Color="{StaticResource ComplementaryDark}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource Complementary}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource ComplementaryDark}"/>
    <SolidColorBrush x:Key="Card" Color="{StaticResource PrimaryLight}"/>
    <SolidColorBrush x:Key="Border" Color="{StaticResource PrimaryMuted}"/>
    <SolidColorBrush x:Key="Gold" Color="{StaticResource SecondaryBDark}"/>
    <SolidColorBrush x:Key="CharacterName" Color="{StaticResource SecondaryADark}"/>
    <SolidColorBrush x:Key="BuyText" Color="{StaticResource SecondaryBDark}"/>
    <SolidColorBrush x:Key="MenuText" Color="{StaticResource PrimaryPale}"/>
</ResourceDictionary>
